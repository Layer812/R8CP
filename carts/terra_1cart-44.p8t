function r8_terra_music_toggle()
 mute=not mute
 dset(1,mute and 1 or 0)
end
function r8_terra_mouse_toggle()
 mouse=not mouse
 dset(0,mouse and 1 or 0)
end
function _update60()
menuitem(5,mute and "music: off" or "music: on",r8_terra_music_toggle)
[/]
